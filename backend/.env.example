# Server Configuration
# For local development: 5000. For AWS Elastic Beanstalk: defaults to 8080 automatically
PORT=5000

# Database Configuration (PostgreSQL Connection String)
# Local example:
# DATABASE_URL=postgresql://postgres:root@localhost:5432/moodbuddy
# AWS RDS / Cloud PostgreSQL (Neon / Supabase) example:
# DATABASE_URL=postgresql://<db_user>:<db_password>@<rds_endpoint_or_host>:5432/<dbname>
DATABASE_URL=postgresql://postgres:root@localhost:5432/moodbuddy

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (Optional in production if served by same server)
CLIENT_URL=http://localhost:5173
NODE_ENV=production
